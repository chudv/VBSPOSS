<script>
    $(document).ready(function () {
        $("#gridMainIDCApproval .k-grid-excel").after("<label id='lbl_spaceApprove' style='padding-top:5px;padding-left: 10px;width:70%; font-size: 11px; font-weight: bold; color: blue;text-align:center;line-height: 25px;'>HÀNG CHỜ DANH SÁCH THÔNG TIN NGƯỜI DÙNG INTELLECT IDC ĐỀ NGHỊ TẠO MỚI/THAY ĐỔI</label>");
        var lcAuthorizePermitTmp = $("#AuthorizePermissionFlagChildView").val();
        var lcReportPermitTmp = $("#ReportPermissionFlagChildView").val();
        var lcFlagCallView = $("#FlagCallView").val();

        if (lcFlagCallView == $("#EventFlag_AuthorizeView").val()) {
            $("#btnPrintToTrinh").hide();
            $("#divApprovalRequestUser").hide();
            if (lcAuthorizePermitTmp == "0" || lcAuthorizePermitTmp == "") {
                $("#divAuthorizeRequestUser").hide();
            }
            else {
                $("#divAuthorizeRequestUser").show();
            }
        }
        else if (lcFlagCallView == $("#EventFlag_ApprovalView").val()) {
            $("#divAuthorizeRequestUser").hide();
            if (lcReportPermitTmp == "0" || lcReportPermitTmp == "") {
                $("#divApprovalRequestUser").hide();
            }
            else $("#divApprovalRequestUser").show();
        }
        if ((lcAuthorizePermitTmp == "0" || lcAuthorizePermitTmp == "") && (lcReportPermitTmp == "0" || lcReportPermitTmp == ""))
        {
            $("#idRejectDiv").hide();
        }

        var cboMainPosCodeApprovalFind = $("#MainPosCodeApproval_Find").data("kendoComboBox");
        var lcMainPosCodeView = $("#MainPosCodeView").val();
        if (lcMainPosCodeView) {
            cboMainPosCodeApprovalFind.value(lcMainPosCodeView);
            // Trigger change để đồng bộ PosName nếu cần
            cboMainPosCodeApprovalFind.trigger("change");
        }

        Change_FunctionTypeApproval();

        //Bỏ không cần tờ trình nữa     $("#divApprovalRequestUserUploadFile").hide();
        $("#fileUpload").hide();
        $("#btnChooseFile").hide();
        $("#fileList").hide();        
    });

    //Hàm thực hiện gọi In tờ trình
    $("#btnPrintToTrinh").click(function () {
        var listUserIdChoiceApprovalTmp = [];

        var grid = $("#gridMainIDCApproval").data("kendoGrid");
        grid.tbody.find(".depProductCheckSelect:checked").each(function () {
            var row = $(this).closest("tr");
            var dataItem = grid.dataItem(row);

            if (!dataItem) return;
            var dataTempRow = {
                    Id: dataItem.Id,
                    UserId: dataItem.UserId,
                    Status: dataItem.Status
                };
            listUserIdChoiceApprovalTmp.push(dataTempRow);
        });

        if (listUserIdChoiceApprovalTmp.length === 0) {
            alert("Bạn chưa chọn danh sách yêu cầu về tài khoản người dùng Intellect iDC để in tờ trình. Vui lòng chọn trình duyệt/Phê duyệt!");
            return;
        }
        var listPrintData = listUserIdChoiceApprovalTmp.filter(function(item) {
            return Number(item.Status) === 1 || Number(item.Status) === 5 || Number(item.Status) === 2;
        });

        if (listPrintData.length === 0) {
            alert("Chưa có dữ liệu thông tin trình duyệt/phê duyệt người dùng IDC. Vui lòng trình duyệt/Phê duyệt!");
            return;
        }

        var lcListId = listPrintData.map(x => x.Id).join(',');
