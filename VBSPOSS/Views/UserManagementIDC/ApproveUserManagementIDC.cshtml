    function onClickRejectApproval(e) {
        var lcFunctionTypeNameChoice = $("#FunctionTypeApproval_Find").data("kendoComboBox").text();
        var iCountRowAuthTmp =  0
        var lcReasonRejectInput = $("#ReasonReject").val();
        if (lcReasonRejectInput == "" || lcReasonRejectInput == null) {
            alert("Bạn phải nhập lý do từ chối đối với các yêu cầu [" + lcFunctionTypeNameChoice + "] đối với tài khoản người dùng đã tích chọn. Vui lòng kiểm tra lại!");
            e.preventDefault();
            $("#ReasonReject").focus();
            return false;
        }
        var listUserIdChoiceRejectApprovalTmp = [];
        var grid = $("#gridMainIDCApproval").data("kendoGrid");
        grid.tbody.find(".depProductCheckSelect:checked").each(function () {
            var row = $(this).closest("tr");
            var dataItem = grid.dataItem(row);

            if (!dataItem) return;

            var listStatusNotReject = [3, 6, 0, 7, 4, 8];
            //  0 - Đóng/Xóa;
            // 1 - Tạo lập;
            // 5 - Chỉnh sửa;
            // 2 - Trình duyệt
            // 3 - Phê duyệt cấp TW;
            // 4 - Từ chối cấp TW;
            // 6 - Phê duyệt cấp Chi nhánh (Với giá trị này là thực thi vào Core iDC nếu thỏa mãn);
            // 7 - Từ chối cấp Chi nhánh;
            // 8 - Chờ phê duyệt đơn vị nhận
            // if (listStatusNotReject.includes(dataItem.Status))
            //if (dataItem.Status != 3 && dataItem.Status != 6 && dataItem.Status != 0 && dataItem.Status != 4 && dataItem.Status != 7 && dataItem.Status != 8) {
            if (!listStatusNotReject.includes(dataItem.Status)) {
                var dataTempRow = {
                        Id: dataItem.Id,
                        UserId: dataItem.UserId,
                        Status: dataItem.Status
                };
                listUserIdChoiceRejectApprovalTmp.push(dataTempRow);
            }
            else {
                iCountRowAuthTmp = iCountRowAuthTmp + 1;
            }
        });

        if (listUserIdChoiceRejectApprovalTmp.length === 0) {
            alert("Bạn chưa chọn danh sách yêu cầu [" + lcFunctionTypeNameChoice + "] trên lưới dữ liệu đối với tài khoản người dùng để từ chối. Vui lòng kiểm tra lại!");
            return;
        }
        if (iCountRowAuthTmp > 0) {
            alert("Danh sách yêu cầu [" + lcFunctionTypeNameChoice + "] trên lưới dữ liệu đối với tài khoản người dùng để từ chối có yêu cầu đã được phê duyệt. Vui lòng kiểm tra lại!");
            return;
        }

        var iCountUserdChoice = listUserIdChoiceRejectApprovalTmp.length.toString();
        var bIsQuestion = confirm("Bạn có chắc chắn muốn Từ chối " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] đối với tài khoản người dùng này không?");
        if (bIsQuestion == true) {

            var lcFlagCallRejectView = $("#EventFlag_RejectView").val();
            var lcSystemDateTextView = $("#SystemDateTextApprovalView").val();
            var lcBusinessDateTextView = $("#BusinessDateTextApprovalView").val();
            var lcFunctionTypeReject = $("#FunctionTypeApproval_Find").data("kendoComboBox").value();
            var lcPosCodeReject = $("#MainPosCodeApproval_Find").data("kendoComboBox").value();

            var formData = new FormData();      //Tạo FormData
            // Append list data
            formData.append("pFlagCall", lcFlagCallRejectView);
            formData.append("pListRejectData", JSON.stringify(listUserIdChoiceRejectApprovalTmp));
            formData.append("pReasonReject", lcReasonRejectInput);
            formData.append("pFunctionType", lcFunctionTypeReject);
            formData.append("pMainPosCode", lcPosCodeReject);
            formData.append("pPosCode", lcPosCodeReject);
            formData.append("pSystemDate", lcSystemDateTextView);
            formData.append("pBusinessDate", lcBusinessDateTextView);

            $.ajax({

                url: '@Url.Action("SaveRejectFunctionTypeOfUserIDC", "UserManagementIDC")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (resultSaveUpdate) {
                    var resultSaveUpdateNew = parseInt(resultSaveUpdate, 10);
                    if (resultSaveUpdate === "0") {
                        alert("Bạn đã từ chối danh sách " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] với tài khoản người dùng đã chọn thành công!");
                        dataChange = false;
                        refreshGridIDCApproval();
                    }
                    else if (resultSaveUpdateNew > 0) {
                        alert("Bạn đã từ chối danh sách " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] với tài khoản người dùng đã chọn, nhưng chỉ thực hiện thành công với " + resultSaveUpdateNew.toString() + " bản ghi có trạng thái hợp lệ!");
                        dataChange = false;
                        refreshGridIDCApproval();
                    }
                    else if (resultSaveUpdate === "-2") {
                        alert("Cờ gọi cập nhật từ chối danh sách " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] không phải là cờ từ chối [" + lcFlagCallRejectView + "]. Vui lòng kiểm tra lại!");
                    }
                    else if (resultSaveUpdate === "-1") {
                        alert("Danh sách từ chối " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] thực hiện không thành công (Có thể do trạng thái không cho phép từ chối). Vui lòng kiểm tra lại!");
                    }
                    else {
                        alert("Có lỗi xảy ra khi từ chối " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] đối với các tài khoản người dùng được chọn. Vui lòng kiểm tra lại!!");
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                    alert("Lỗi hệ thống!");
                }
            });
        }
        else {
            alert("Thao tác Từ chối " + iCountUserdChoice + " yêu cầu [" + lcFunctionTypeNameChoice + "] đối với tài khoản người bị hủy bỏ!");
        }
    }

    function add_AttachFilesLinkOfUserId(listFileId, userId) {
        var lcFileTypeTmp = "2";
        var lcDelimiter = ";"
        if (listFileId != "") {
            $.ajax({
                type: "GET",
                url: "../ListOfValue/GetListAttachedFileInfoForDocumentId?pListFileId=" + listFileId + '&' + 'pFileType=' + lcFileTypeTmp + '&' + 'pDelimiter=' + lcDelimiter,
                success: function (data) {
                    files = data;
                    if (files != null) {
                        $("#_no_file_attachIdDocumentApproval").text("");
                        for (i = 0; i < files.length; i++) {
                            var iOrderNoTmp = i + 1;
                            html = '<a title="' + files[i].ContentDescription + '" href="#" onclick=showFileApprovalUserIDC(' + files[i].DocumentId + ',' + files[i].FileId + ',"' + files[i].FileNameNew + '","' + userId + '")' + '>' + ' [' + iOrderNoTmp + '] ' + "</a>&nbsp;";
                            $("#_no_file_attachIdDocumentApproval").append(html);
                        }
                    }
                }
            });
        }
    }

    function showFileApprovalUserIDC(documentId, fileId, fileNameNew, userId) {
        var win = window.open('../UserManagementIDC/LoadPdfFile?pDocumentId=' + documentId + '&' + 'pFileId=' + fileId + '&' + 'pFileName=' + fileNameNew, '_blank');
        if (win) {
            win.focus();
        } else {
            alert('Please allow popups for this website');
        }
    }

    function onRowSelectUserId(e) {
        $("#_no_file_attachIdDocumentApproval").text("");
        $("#divInforUserSelect").text("");
        var gridApprovalUserIDC = $("#gridMainIDCApproval").data("kendoGrid");
        if (gridApprovalUserIDC.dataSource.total() === 0) {
            console.log("Grid không có bản ghi nào!");
            return; // Thoát hàm
        }
        // Lấy row đang được chọn
        var selectedRow = this.select();           // "this" ở đây là Grid

        if (selectedRow.length > 0) {
            var dataItem = gridApprovalUserIDC.dataItem(selectedRow);   // ← Đây là dataItem bạn cần
            add_AttachFilesLinkOfUserId(dataItem.ListFileId, dataItem.UserId)
            $("#divInforUserSelect").text(" Tài khoản đang xem " + dataItem.UserId + " | " + dataItem.FullName + "   ");
        }
        else {
            console.log("Không có bản ghi nào được chọn");
        }
    }
</script>

