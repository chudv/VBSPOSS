    function openAuthorizeWindow(dataItem, eventCodeView, windowTitle) {
        var wnd = mainWindowApproval.data("kendoWindow");
        if (!wnd) {
            mainWindowApproval.kendoWindow({
                width: "1024px",
                height: "700px",
                resizable: false,
                visible: false,
                modal: true,
                close: onCloseApprove,
                actions: ["Refresh", "Close"]
            });
            wnd = mainWindowApproval.data("kendoWindow");
        }
        // Xóa nội dung cũ trước
        wnd.content("");
        // Đổi title
        wnd.setOptions({
            title: windowTitle
        });
        var lcEventDetailView = $("#EventFlag_ViewView").val();
        var lcButtonType = "";
        var lcEventAuthorizeView = $("#EventFlag_AuthorizeView").val();
        if (eventCodeView == lcEventDetailView) {

            lcButtonType = eventCodeView;
            eventCodeView = lcEventAuthorizeView;
        }

        // Refresh lại với cache false
        wnd.refresh({
            url: '@Url.Action("ShowUpdateUserManagementIDC", "UserManagementIDC")',
            data: {
                pId: dataItem.Id,
                pPosCode: dataItem.PosCode,
                pUserId: dataItem.UserId,
                pFlagCall: eventCodeView,
                pButtonType: lcButtonType,
                _t: new Date().getTime()    // chống cache
            }
        });
        wnd.center().open();
    }

    //Lưu lại các item đã chọn khi Show Form chi tiết Trình duyệt/Phê duyệt tạm
    var listApprovalData = []; // danh sách tổng
    function receiveDataFromChild(data) {
        //Tránh trùng theo Id
        var index = listApprovalData.findIndex(x => x.Id === data.Id);
        if (index !== -1) {
            // Nếu đã tồn tại thì update
            listApprovalData[index] = data;
        } else {
            // nếu chưa có thì thêm mới
            listApprovalData.push(data);
        }
        console.log("Danh sách hiện tại:", listApprovalData);
        // lưu vào hidden để submit sau
        $("#hiddenApprovalData").val(JSON.stringify(listApprovalData));
    }

