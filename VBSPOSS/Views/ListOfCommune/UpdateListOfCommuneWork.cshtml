@model VBSPOSS.ViewModels.ListOfCommuneWorksViewModel
@using VBSPOSS.Models
@using VBSPOSS.Constants
@using VBSPOSS.ViewModels

<div id="mySppLocality"></div>

<style>
    .k-animation-container {
        z-index: 100000 !important;
    }

    .readonly-field input, .readonly-field .k-input {
        background-color: #f0f0f0 !important;
    }

    .section-title {
        color: maroon;
        font-weight: bold;
        margin: 15px 0 8px 0;
    }

    .radio-group label {
        margin-right: 25px;
        font-weight: normal;
    }

    .left-column {
        border-right: 2px solid #eee;
        padding-right: 25px;
    }

    .right-column {
        padding-left: 25px;
    }

    h5 {
        color: navy;
        font-weight: bold;
        margin-bottom: 15px;
    }
</style>

<script>

     window.notification = window.notification || {
         success: function (msg) { alert("✅ " + (msg || "Thành công!")); },
         error: function (msg) { alert("❌ " + (msg || "Có lỗi xảy ra!")); }
     };

    function paramLoadProvinces() { return { pFlagTextShow: "2", pStatus: "0" }; }
    function paramLoadDistricts() { return { pProvinceCode: $("#ProvinceCode").val(), pFlagTextShow: "2" }; }
    function paramLoadCommunes() {
        return {
            pProvinceCode: $("#ProvinceCode").val(),
            pDistrictCode: $("#DistrictCode").val(),
            pFlagTextShow: "2"
        };
    }


        function paramLoadSubCommunes() {
        return {
            pProvinceCode: $("#ProvinceCode").val(),
            pDistrictCode: $("#DistrictCode").val(),
            pCommuneCode: $("#CommuneCodeThon").val(),
            pFlagTextShow: "3"
        };
    }
    function Change_Province() {
        $("#DistrictCode").data("kendoComboBox")?.dataSource.read();
        $("#DistrictCode").data("kendoComboBox")?.value("");
        $("#CommuneCodeThon").data("kendoComboBox")?.value("");
    }

    function Change_District() {
        $("#CommuneCodeThon").data("kendoComboBox")?.dataSource.read();
    }

    function Change_CommuneThon() {
        var communeCode = $("#CommuneCodeThon").val();
        $("#TxnPointCode").val(""); // Reset trước khi load

        if (communeCode) {
            $.ajax({
                url: "/ListOfValue/GetTxnPointCodeByCommune",
                type: "GET",
                data: { communeCode: communeCode },
                success: function (result) {
                    if (typeof result === "string") {
                        $("#TxnPointCode").val(result);
                    } else if (result && result.code) {
                        $("#TxnPointCode").val(result.code);
                    }
                },
                error: function () {
                    $("#TxnPointCode").val("");
                }
            });
        }
    }


    function onCloseUpdate() {
        if (typeof mainWindow !== "undefined" && mainWindow.data("kendoWindow")) {
            mainWindow.data("kendoWindow").close();
        } else if (window.parent && window.parent.$("#wndListOfCommune")) {
            window.parent.$("#wndListOfCommune").data("kendoWindow").close();
        }
    }

    function onClick(e) {
        var addType = $('input[name="AddType"]:checked').val();
        if (!$("#ProvinceCode").val()) { alert("Vui lòng chọn Tỉnh/Thành phố!"); $("#ProvinceCode").focus(); e.preventDefault(); return false; }
        if (!$("#DistrictCode").val()) { alert("Vui lòng chọn Quận/Huyện!"); $("#DistrictCode").focus(); e.preventDefault(); return false; }

        if (addType === "Xa") {
            if (!$("#CommuneCode").val()) { alert("Vui lòng chọn Mã Phường/Xã!"); $("#CommuneCode").focus(); e.preventDefault(); return false; }
        } else if (addType === "Thon") {
            if (!$("#CommuneCodeThon").val()) { alert("Vui lòng chọn Xã/Phường!"); $("#CommuneCodeThon").focus(); e.preventDefault(); return false; }
            if (!$("#SubCommuneName").val().trim()) { alert("Vui lòng nhập Tên Thôn/Bản/Làng!"); $("#SubCommuneName").focus(); e.preventDefault(); return false; }
            if (!$("#SubCommuneCode").val().trim()) { alert("Vui lòng chọn Mã Tổ/Thôn!"); $("#SubCommuneCode").focus(); e.preventDefault(); return false; }
        }
        return true;
    }

       $(document).ready(function () {
        $('#radioThon').prop('checked', true);

        // Xử lý nút Load Mã Tổ/Thôn
        $("#btnLoadSubCommune").click(function () {
            var subCommuneCombo = $("#SubCommuneCode").data("kendoComboBox");
            if (subCommuneCombo) {
                subCommuneCombo.dataSource.read();
            }
        });

        // Đồng bộ Mã Quận/Huyện
        $("#DistrictCode").change(function () {
            $("#DistrictCodeThon").val($(this).val());
        });

        // Load lại Xã khi thay đổi Quận/Huyện
        $("#DistrictCode").change(function () {
            var combo = $("#CommuneCodeThon").data("kendoComboBox");
            if (combo) combo.dataSource.read();
        });
    });
</script>

<script>
    $(function () {
        $("#form0").submit(function (e) {
            e.preventDefault();
            if (!onClick(e)) return false;
            submitFormAjax(this);
        });
    });

       function submitFormAjax(form) {
        $.ajax({
            url: form.action,
            type: "POST",
            data: new FormData(form),
            contentType: false,
            processData: false,
            success: function (result) {
                if (result === "0" || result === 0) {
                    window.notification.success("Thêm mới thành công!");
                    dataChange = true;
                    onCloseUpdate();
                } else {
                    window.notification.error("Lỗi: " + (result || "Không xác định"));
                }
            },
            error: function (xhr, status, err) {
                window.notification.error("Lỗi kết nối! Vui lòng thử lại.");
                console.error(xhr, status, err);
            }
        });
    }
</script>

<form asp-controller="ListOfCommune" asp-action="SaveAddOrUpdateListOfCommuneWork"
      data-ajax="true" data-ajax-method="POST" id="form0" enctype="multipart/form-data">

    @Html.HiddenFor(m => m.FlagCall)
    @Html.HiddenFor(m => m.OrderNo)
    @Html.HiddenFor(m => m.ParentId)
    @Html.HiddenFor(m => m.DocumentId)
    @Html.HiddenFor(m => m.StatusUpdateCore)
    @Html.HiddenFor(m => m.CallApiTxnStatus)
    @Html.HiddenFor(m => m.CallApiResRecords)
    @Html.HiddenFor(m => m.CallApiResponseCode)
    @Html.HiddenFor(m => m.CallApiResponseMsg)

    @Html.HiddenFor(m => m.PosCodeOldInfo)
    @Html.HiddenFor(m => m.ProvinceCodeOldInfo)
    @Html.HiddenFor(m => m.DistrictCodeOldInfo)
    @Html.HiddenFor(m => m.CommuneCodeOldInfo)
    @Html.HiddenFor(m => m.SubCommuneCodeOldInfo)
    @Html.HiddenFor(m => m.StatusOldInfo)
    @Html.HiddenFor(m => m.SubCommuneFeeLenArea)



    <div class="lbtitle" style="color: blue; text-align:center; padding: 12px 0; font-weight: bold; font-size: 16px;">
        TẠO YÊU CẦU THÊM MỚI DANH MỤC ĐỊA PHƯƠNG
    </div>
    <hr />

    <div class="row" style="padding: 10px 0;">
        <div class="col-md-12 radio-group">
            <label><input type="radio" name="AddType" value="Xa" id="radioXa" /> Thêm mới Xã</label>
            <label><input type="radio" name="AddType" value="Thon" id="radioThon" checked /> Thêm mới Thôn</label>
        </div>
    </div>

    <div class="row">
        <!-- ==================== BÊN TRÁI: THÊM MỚI XÃ (GIỮ NGUYÊN) ==================== -->
        <div class="col-md-6 left-column">
            <h5>Thêm mới Xã</h5>
            <div class="row" style="margin-top: 12px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;width:170px">Tỉnh/Thành phố <span style="color:red">*</span></label>
                    @(Html.Kendo().ComboBoxFor(m => m.ProvinceCode)
                        .Filter(FilterType.Contains)
                        .Placeholder("--- Chọn Tỉnh/Thành phố ---")
                        .DataTextField("value").DataValueField("id")
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .Events(e => e.Change("Change_Province"))
                        .DataSource(ds => ds.Read(read => read.Action("GetListProvinces", "ListOfValue").Data("paramLoadProvinces")))
                        .Suggest(true).AutoBind(true))
                </div>
            </div>
            <div class="row" style="margin-top: 12px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;;width:170px">Quận/Huyện <span style="color:red">*</span></label>
                    @(Html.Kendo().ComboBoxFor(m => m.DistrictCode)
                        .Filter(FilterType.Contains)
                        .Placeholder("--- Chọn Quận/Huyện ---")
                        .DataTextField("value").DataValueField("id")
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .Events(e => e.Change("Change_District"))
                        .DataSource(ds => ds.Read(read => read.Action("GetListDistricts", "ListOfValue").Data("paramLoadDistricts")))
                        .Suggest(true).AutoBind(false))
                </div>
            </div>
            <div class="row" style="margin-top: 12px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;;width:170px">Phường/Xã <span style="color:red">*</span></label>
                    @(Html.Kendo().ComboBox()
                        .Name("CommuneCode")
                        .Filter(FilterType.Contains)
                        .Placeholder("--- Chọn Xã/Phường ---")
                        .DataTextField("value")
                        .DataValueField("id")
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataSource(ds => ds.Read(read => read.Action("GetListCommunes", "ListOfValue").Data("paramLoadCommunes")))
                        .Suggest(true).AutoBind(false))
                </div>
            </div>
        </div>

        <!-- ==================== BÊN PHẢI: THÊM MỚI THÔN ==================== -->
        <div class="col-md-6 right-column">
            <h5>Thêm mới Thôn</h5>

            <div class="row" style="margin-top: 12px;">
                <div class="col-md-6">
                    <label class="lbcontrol" style="color: navy;">Mã Quận/Huyện</label>
                    @Html.Kendo().TextBoxFor(m => m.DistrictCode).HtmlAttributes(new { style = "width: 100%;", @readonly = "readonly", id = "DistrictCodeThon" })
                </div>
                <div class="col-md-6">
                    <label class="lbcontrol" style="color: navy;">Mã Phường/Xã <span style="color:red">*</span></label>
                    @(Html.Kendo().ComboBox()
                        .Name("CommuneCodeThon")
                        .Filter(FilterType.Contains)
                        .Placeholder("--- Chọn Xã/Phường ---")
                        .DataTextField("value")
                        .DataValueField("id")
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataSource(ds => ds.Read(read => read.Action("GetListCommunes", "ListOfValue").Data("paramLoadCommunes")))
                        .Events(e => e.Change("Change_CommuneThon"))
                        .Suggest(true).AutoBind(false))
                </div>
            </div>

            <!-- ==================== MÃ ĐIỂM GDX ==================== -->
            <div class="row" style="margin-top: 12px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;">Mã Điểm GDX </label>
                    @Html.Kendo().TextBoxFor(m => m.TxnPointCode).HtmlAttributes(new { style = "width: 100%;", @readonly = "readonly", id = "TxnPointCode" })
                </div>
            </div>

            <div class="row" style="margin-top: 12px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;;width:170px">Tên Thôn/Bản/Làng <span style="color:red">*</span></label>
                    @Html.Kendo().TextBoxFor(m => m.SubCommuneName).HtmlAttributes(new { style = "width: 100%;" })
                </div>
            </div>

            <div class="row" style="margin-top: 8px;">
                <div class="col-md-12">
                    <button type="button" class="k-button" id="btnLoadSubCommune" style="width:100%;">Load Mã Tổ/Thôn</button>
                </div>
            </div>

            <div class="row" style="margin-top: 12px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;;width:170px">Mã Tổ/Thôn <span style="color:red">*</span></label>
                    @(Html.Kendo().ComboBox()
                        .Name("SubCommuneCode")
                        .Filter(FilterType.Contains)
                        .Placeholder("--- Chọn Mã Tổ/Thôn ---")
                        .DataTextField("value")
                        .DataValueField("id")
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataSource(ds => ds.Read(read => read.Action("GetListSubCommunes", "ListOfValue").Data("paramLoadSubCommunes")))
                        .Suggest(true)
                        .AutoBind(false))
                </div>
            </div>

            <!-- ==================== TRƯỜNG MỚI: VÙNG KHÓ KHĂN CẤP THÔN ==================== -->
            <div class="row" style="margin-top: 20px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;">
                        Vùng khó khăn <span style="color:red">*</span>
                    </label>
                    @(Html.Kendo().DropDownListFor(m => m.DiffAreaCode)
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .BindTo(new[] {
                    new { Text = "-- Chọn --", Value = "" },
                    new { Text = "0 - Không phải vùng khó khăn", Value = "0" },
                    new { Text = "1 - Vùng khó khăn", Value = "1" }
                    })
                        .Value("0"))
                </div>
            </div>

            <div class="row" style="margin-top: 15px;">
                <div class="col-md-12">
                    <label class="lbcontrol" style="color: navy;">
                        Thuộc nông thôn mới <span style="color:red">*</span>
                    </label>
                    @(Html.Kendo().DropDownListFor(m => m.IsNewCountryside)
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .BindTo(new[] {
                    new { Text = "-- Chọn --", Value = "" },
                    new { Text = "Y - Có", Value = "Y" },
                    new { Text = "N - Không", Value = "N" }
                    })
                        .Value("N"))
                </div>
            </div>


            <div class="section-title">Vùng cho vay</div>
            <div class="row">
                <div class="col-md-12">
                    <label><input type="checkbox" name="Region_01" value="Y" /> 01-Nông thôn</label>
                    <label><input type="checkbox" name="Region_02" value="Y" /> 02-Thành thị</label>
                    <label><input type="checkbox" name="Region_03" value="Y" /> 03-Khó khăn</label>
                    <label><input type="checkbox" name="Region_04" value="Y" /> 04-Định canh, Định cư</label>
                </div>
            </div>

            <div class="row" style="margin-top: 12px;">
                <div class="col-md-6">
                    <label class="lbcontrol">Vùng kinh tế</label>
                    @Html.Kendo().DropDownListFor(m => m.AreaEconomic).HtmlAttributes(new { style = "width: 100%;" }).BindTo(new[] { "--Vùng kinh tế--", "01", "02", "03", "04" })
                </div>
                <div class="col-md-6">
                    <label class="lbcontrol">Xã 135</label>
                    @Html.Kendo().DropDownListFor(m => m.CommuneFlag135).BindTo(new[] { "", "Y", "N" }).HtmlAttributes(new { style = "width: 100%;" })
                </div>
            </div>
        </div>
    </div>

    <!-- Buttons -->
    <div class="row" style="padding-top: 25px; text-align: right;">
        <label id="lblMessageInfor" style="color: red; margin-right: 20px;"></label>
        @(Html.Kendo().Button().Name("btnSave").Content("Thêm mới").HtmlAttributes(new { type = "submit", style = "width: 120px; font-weight:bold;" }))
        @(Html.Kendo().Button().Name("btnThoat").Content("Quay ra").HtmlAttributes(new { type = "button", style = "width: 120px; margin-left: 10px;" }).Events(ev => ev.Click("onCloseUpdate")))
    </div>
</form>

<script>
    $(document).ready(function () {
        $("#DiffAreaCode").change(function () {
            var value = $(this).val();

            if (value === "1") {
                $("#SubCommuneFeeLenArea").val("VKK");
            } else {
                $("#SubCommuneFeeLenArea").val("");   // NULL
            }
        });

        // Set giá trị ban đầu nếu có
        if ($("#DiffAreaCode").val() === "1") {
            $("#SubCommuneFeeLenArea").val("VKK");
        }
    });
</script>