        <div class="col-md-12">
            <div class="form-row">
                <label class="lbcontrol">Tỉnh/Thành phố <span style="color:red">*</span></label>
                @(Html.Kendo().ComboBoxFor(m => m.ProvinceCode)
                    .Filter(FilterType.Contains)
                    .Placeholder("--- Chọn Tỉnh/Thành phố ---")
                    .DataTextField("value").DataValueField("id")
                    .HtmlAttributes(new { style = "width: 350px;" })
                    .Events(e => e.Change("Change_Province"))
                    .DataSource(ds => ds.Read(read => read.Action("GetListProvinces", "ListOfValue").Data("paramLoadProvinces")))
                    .Suggest(true)
                    .AutoBind(true))
            </div>
        </div>
    </div>
 *@

    <div class="row" style="padding: 15px 0;">
        <div class="col-md-12">
            <div class="form-row">
                <label class="lbcontrol">Tỉnh/Thành phố <span style="color:red">*</span></label>
                @(Html.Kendo().ComboBox()
                    .Name("ProvinceCodeMain") 
                    .Filter(FilterType.Contains)
                    .Placeholder("--- Chọn Tỉnh/Thành phố ---")
                    .DataTextField("value").DataValueField("id")
                    .HtmlAttributes(new { style = "width: 350px;" })
                    .Events(e => e.Change("Change_Province"))
                    .DataSource(ds => ds.Read(read => read.Action("GetListProvinces", "ListOfValue").Data("paramLoadProvinces")))
                    .Suggest(true)
                    .AutoBind(true))
            </div>
        </div>
    </div>

    @Html.HiddenFor(m => m.ProvinceCode)   <!-- Hidden này dùng để submit dữ liệu -->
    <!-- ==================== PHẦN CHÍNH - THEO KIỂU NGANG ==================== -->
    <div class="row">
        <!-- Thêm mới Xã -->
        <div class="col-md-6">
            <h5 style="color: navy; font-weight: bold;">Thêm mới Xã</h5>

         

            <div class="form-row">
                <label class="lbcontrol">Mã Phường/Xã <span style="color:red">*</span></label>
                @Html.Kendo().TextBoxFor(m => m.CommuneCode).HtmlAttributes(new { style = "width: 300px;" })
            </div>

            <div class="form-row">
                <label class="lbcontrol">Tên Phường/Xã <span style="color:red">*</span></label>
                @Html.Kendo().TextBoxFor(m => m.CommuneName).HtmlAttributes(new { style = "width: 300px;" })
            </div>
        </div>

        <!-- Thêm mới Thôn -->
        <div class="col-md-6">
            <h5 style="color: navy; font-weight: bold;">Thêm mới Thôn</h5>

           
          

            <div class="form-row">
                <label class="lbcontrol">Phường/Xã <span style="color:red">*</span></label>
                @(Html.Kendo().ComboBox()
                    .Name("CommuneCodeThon")
                    .Filter(FilterType.Contains)
                    .Placeholder("--- Chọn Phường/Xã ---")
                    .DataTextField("value")
                    .DataValueField("id")
                    .HtmlAttributes(new { style = "width: 300px;" })
                    .DataSource(ds => ds.Read(read => read.Action("GetListCommunes", "ListOfValue").Data("paramLoadCommunes")))
                    .Events(e => e.Change("Change_CommuneThon"))
                    .Suggest(true).AutoBind(false))
            </div>

            <div class="form-row">
                <label class="lbcontrol">Mã Điểm GDX</label>
                @Html.Kendo().TextBoxFor(m => m.TxnPointCode).HtmlAttributes(new { style = "width: 300px;", @readonly = "readonly", id = "TxnPointCode" })
            </div>

            <div class="form-row">
                <label class="lbcontrol">Tên Thôn/Bản/Làng <span style="color:red">*</span></label>
                @Html.Kendo().TextBoxFor(m => m.SubCommuneName).HtmlAttributes(new { style = "width: 300px;" })
            </div>

            <div class="form-row">
                <label class="lbcontrol">Mã Tổ/Thôn <span style="color:red">*</span></label>
                @Html.Kendo().TextBoxFor(m => m.SubCommuneCode).HtmlAttributes(new { style = "width: 300px;" })
            </div>
        </div>
    </div>

    <!-- Phần bổ sung chung -->
    <div class="row" style="margin-top: 20px;">
        <div class="col-md-12">
            <div class="section-title">Thông tin bổ sung</div>

            <div class="form-row">
                <label class="lbcontrol" style="width:160px">Vùng khó khăn <span style="color:red">*</span></label>
                @(Html.Kendo().DropDownListFor(m => m.DiffAreaCode)
                    .HtmlAttributes(new { style = "width: 200px;" })
                    .DataTextField("Text").DataValueField("Value")
                    .BindTo(new[] { new { Text = "-- Chọn --", Value = "" }, new { Text = "0 - Không", Value = "0" }, new { Text = "1 - Vùng khó khăn", Value = "1" } })
                    .Value("0"))
            </div>

            <div class="form-row">
                <label class="lbcontrol" style="width:160px">Thuộc nông thôn mới <span style="color:red">*</span></label>
                @(Html.Kendo().DropDownListFor(m => m.IsNewCountryside)
                    .HtmlAttributes(new { style = "width: 200px;" })
                    .DataTextField("Text").DataValueField("Value")
                    .BindTo(new[] { new { Text = "-- Chọn --", Value = "" }, new { Text = "Y - Có", Value = "Y" }, new { Text = "N - Không", Value = "N" } })
                    .Value("N"))
            </div>
            <div class="form-row">
                <div class="col-md-6">
                    <label class="lbcontrol">Vùng kinh tế</label>
                    @(Html.Kendo().DropDownListFor(m => m.AreaEconomic)
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .BindTo(new[] {
                    new { Text = "-- Chọn vùng kinh tế --", Value = "" },
                    new { Text = "KTNT - Kinh tế nông thôn", Value = "KTNT" },
                    new { Text = "01", Value = "01" },
                    new { Text = "02", Value = "02" },
                    new { Text = "03", Value = "03" },
                    new { Text = "04", Value = "04" }
                    })
                        .Value("KTNT"))
                </div>

                <div class="col-md-6">
                    <label class="lbcontrol">Xã 135</label>
                    @(Html.Kendo().DropDownListFor(m => m.CommuneFlag135)
                        .HtmlAttributes(new { style = "width: 100%;" })
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .BindTo(new[] {
                    new { Text = "-- Chọn --", Value = "" },
                    new { Text = "Có", Value = "Y" },
                    new { Text = "Không", Value = "N" }
                    })
                        .Value("1"))
                </div>
            </div>

        </div>
    </div>

    <!-- Buttons -->
    <div class="row" style="padding-top: 25px; text-align: right;">
        <label id="lblMessageInfor" style="color: red; margin-right: 20px;"></label>
        @(Html.Kendo().Button().Name("btnSave").Content("Thêm mới").HtmlAttributes(new { type = "submit", style = "width: 120px; font-weight:bold;" }))
        @(Html.Kendo().Button().Name("btnThoat").Content("Quay ra").HtmlAttributes(new { type = "button", style = "width: 120px; margin-left: 10px;" }).Events(ev => ev.Click("onCloseUpdate")))
    </div>
</form>
<script>
    $(document).ready(function () {
        $("#EventCode").val("LOCALITY_ADDNEW");
        $("#AddType").val($('input[name="AddType"]:checked').val());

        // Tự động gán ProvinceName khi chọn Tỉnh
        // function bindProvinceName() {
        //     var combo = $("#ProvinceCode").data("kendoComboBox");
          
        //     if (combo) {
        //         combo.bind("change", function(e) {
        //             var dataItem = this.dataItem();
        //             if (dataItem) {
        //                 var provinceName = dataItem.text || dataItem.value || "";
        //                 $("#ProvinceName").val(provinceName);
        //             }
        //         });
        //     }
        // }

            function bindProvinceName() {
        var combo = $("#ProvinceCodeMain").data("kendoComboBox");
        if (combo) {
            combo.bind("change", function(e) {
                var dataItem = this.dataItem();
                if (dataItem) {
                    var provinceName = dataItem.text || dataItem.value || "";
                    $("#ProvinceName").val(provinceName);
                    $("#ProvinceCode").val(dataItem.id || provinceCode);   // Gán code vào hidden
                }
            });
        }
    }

        bindProvinceName();

        // Xử lý hiển thị / ẩn phần Xã hoặc Thôn
        function toggleFormType() {
            var addType = $('input[name="AddType"]:checked').val();
            if (addType === "Xa") {
                $("#divXa").show();
                $("#divThon").hide();
            } else {
                $("#divXa").hide();
                $("#divThon").show();
            }
        }

        // Bind event cho Radio button
        $('input[name="AddType"]').on('change', toggleFormType);
        toggleFormType(); // Gọi lần đầu khi load form

        // Submit form
        $("#form0").submit(function () {
            var addType = $('input[name="AddType"]:checked').val();
            $("#AddType").val(addType);

            if (addType === "Thon") {
                var communeCodeThon = $("#CommuneCodeThon").val();
                $("#CommuneCode").val(communeCodeThon || "");
            }
            else if (addType === "Xa") {
                $("#SubCommuneCode").val("00000");
                $("#SubCommuneName").val("");
                $("#TxnPointCode").val("");
            }

            // Đảm bảo ProvinceName đã được gán
            if ($("#ProvinceName").val() === "") {
                var provinceCombo = $("#ProvinceCode").data("kendoComboBox");
               
                if (provinceCombo) {
                    var dataItem = provinceCombo.dataItem();
                    if (dataItem) {
                        $("#ProvinceName").val(dataItem.text || dataItem.value || "");
                    }
                }
            }

            return true;
        });
    });
</script>
