@model VBSPOSS.ViewModels.ListOfCommuneWorksViewModel
@using VBSPOSS.Models
@using VBSPOSS.Constants
@using VBSPOSS.ViewModels

<div id="mySppLocality"></div>

<style>
    .k-animation-container {
        z-index: 100000 !important;
    }

    .readonly-field input, .readonly-field .k-input {
        background-color: #f0f0f0 !important;
    }

    .section-title {
        color: maroon;
        font-weight: bold;
        margin: 15px 0 8px 0;
    }

    .form-row {
        margin-bottom: 12px;
    }

    label.lbcontrol {
        color: navy;
        width: 160px;
        text-align: right;
        padding-right: 10px;
        padding-top: 7px;
    }

    /* Ẩn input ẩn của Kendo ComboBox nếu bị duplicate */
    input[name="ProvinceCode"][type="hidden"] {
        display: none !important;
    }
</style>

<script>
    window.notification = window.notification || {
        success: function (msg) { alert("✅ " + (msg || "Thành công!")); },
        error: function (msg) { alert("❌ " + (msg || "Có lỗi xảy ra!")); }
    };

   
        function paramLoadProvinces() {
        return {
            pFlagTextShow: "2",
            pStatus: "0",
            pPosCode: $("#CurrentUserPosCode").val() || ""
        };
    }

    function paramLoadCommunes() {
        return {
            pProvinceCode: $("#ProvinceCode").val(),
            pDistrictCode: "",
            pFlagTextShow: "2"
        };
    }

    // function Change_Province() {
    //     var provinceCode = $("#ProvinceCode").val();
      
    //     $("#ProvinceCodeThon").val(provinceCode);

    //     $("#CommuneCode").data("kendoComboBox")?.dataSource.read();
    //     $("#CommuneCodeThon").data("kendoComboBox")?.dataSource.read();
    // }
        function Change_Province() {
        var provinceCode = $("#ProvinceCodeMain").val();
        $("#ProvinceCodeThon").val(provinceCode);
        $("#CommuneCode").data("kendoComboBox")?.dataSource.read();
        $("#CommuneCodeThon").data("kendoComboBox")?.dataSource.read();

        // Gán giá trị vào hidden field
        $("#ProvinceCode").val(provinceCode);
    }


    function Change_CommuneThon() {
        var communeCode = $("#CommuneCodeThon").val();
        $("#TxnPointCode").val("");
        if (communeCode) {
            $.ajax({
                url: "/ListOfValue/GetTxnPointCodeByCommune",
                type: "GET",
                data: { communeCode: communeCode },
                success: function (result) {
                    $("#TxnPointCode").val(typeof result === "string" ? result : (result?.code || ""));
                },
                error: function () { $("#TxnPointCode").val(""); }
            });
        }
    }

    function onCloseUpdate() {
        if (typeof mainWindow !== "undefined" && mainWindow.data("kendoWindow")) {
            mainWindow.data("kendoWindow").close();
        } else if (window.parent && window.parent.$("#wndListOfCommune")) {
            window.parent.$("#wndListOfCommune").data("kendoWindow").close();
        }
    }

    function onClick(e) {
        var addType = $('input[name="AddType"]:checked').val();
        if (!$("#ProvinceCode").val()) {
            alert("Vui lòng chọn Tỉnh/Thành phố!"); $("#ProvinceCode").focus(); e.preventDefault(); return false;
        }
        if (addType === "Xa") {
            if (!$("#CommuneCode").val().trim()) { alert("Vui lòng nhập Mã Phường/Xã!"); $("#CommuneCode").focus(); e.preventDefault(); return false; }
            if (!$("#CommuneName").val().trim()) { alert("Vui lòng nhập Tên Phường/Xã!"); $("#CommuneName").focus(); e.preventDefault(); return false; }
        } else if (addType === "Thon") {
            if (!$("#CommuneCodeThon").val()) { alert("Vui lòng chọn Phường/Xã!"); $("#CommuneCodeThon").focus(); e.preventDefault(); return false; }
            if (!$("#SubCommuneName").val().trim()) { alert("Vui lòng nhập Tên Thôn/Bản/Làng!"); $("#SubCommuneName").focus(); e.preventDefault(); return false; }
            if (!$("#SubCommuneCode").val().trim()) { alert("Vui lòng nhập Mã Tổ/Thôn!"); $("#SubCommuneCode").focus(); e.preventDefault(); return false; }
        }
        return true;
    }
</script>

<form asp-controller="ListOfCommune" asp-action="SaveUpdateListOfCommuneWork" data-ajax="true" data-ajax-method="POST" id="form0" enctype="multipart/form-data">
    @* Hidden fields *@
    @Html.HiddenFor(m => m.FlagCall)
    @Html.HiddenFor(m => m.OrderNo)
    @Html.HiddenFor(m => m.ParentId)
    @Html.HiddenFor(m => m.DocumentId)
    @Html.HiddenFor(m => m.StatusUpdateCore)
    @Html.HiddenFor(m => m.SubCommuneFeeLenArea)
    @Html.HiddenFor(m => m.EventCode)
    @Html.HiddenFor(m => m.AddType)
     @Html.Hidden("pFlagCall", "1") 
    @Html.HiddenFor(m => m.CommuneCode)
    @Html.HiddenFor(m => m.ProvinceName)
    @Html.HiddenFor(m => m.ProvinceCode)
    @Html.Hidden("CurrentUserPosCode", TempData["UserPosCode"]?.ToString() ?? "")
    
    <!-- Các hidden khác giữ nguyên nếu cần -->

    <div class="lbtitle" style="color: blue; text-align:center; padding: 12px 0; font-weight: bold; font-size: 16px;">
        TẠO YÊU CẦU THÊM MỚI DANH MỤC ĐỊA PHƯƠNG
    </div>
    <hr />

    <div class="row" style="padding: 10px 0;">
        <div class="col-md-12 radio-group">
            <label><input type="radio" name="AddType" value="Xa" id="radioXa" /> Thêm mới Xã</label>
            <label><input type="radio" name="AddType" value="Thon" id="radioThon" checked /> Thêm mới Thôn</label>
        </div>
    </div>

   

