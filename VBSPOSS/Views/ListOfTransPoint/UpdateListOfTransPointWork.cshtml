            pStatus: "O",
            pShortName: "1",
            pTitleChoice: "",
            pFlagTextShow: "3",
            pUserPosCode: "",
            pUserName: "",
            pFlagWholeBank: 1
        };
    }

    function paramLoadListProvince() {
        var objPosCodeSelect = $("#PosCode").data("kendoComboBox").value();
        return {
            pProvinceCode: "",
            pStatus: "0",
            pTitleChoice: "",
            pFlagTextShow: "2",
            pPosCode: objPosCodeSelect
        };
    }

    function paramLoadListCommune() {
        var objPosCodeSelect = $("#PosCode").data("kendoComboBox").value();
        var objProvince = $("#ProvinceCode").data("kendoComboBox").value();
        return {
            pProvinceCode: objProvince,
            pStatus: "0",
            pTitleChoice: "",
            pFlagTextShow: "2",
            pPosCode: objPosCodeSelect
        };
    }

    function paramLoadListSubCommune() {
        var objPosCodeSelect = $("#PosCode").data("kendoComboBox").value();
        var objProvince = $("#ProvinceCode").data("kendoComboBox").value();
        var objCommune = $("#CommuneCode").data("kendoComboBox").value();
        return {
            pProvinceCode: objProvince,
            pStatus: "0",
            pTitleChoice: "",
            pFlagTextShow: "2",
            pPosCode: objPosCodeSelect,
            pCommuneCode: objCommune
        };
    }

    function paramLoadListStaffFind() {
        return {
            pPosCode: $("#PosCode").data("kendoComboBox").value(),
            pTitleChoice: "",
            pFlagTextShow: "2",
            pFlagCall: "2"
        };
    }

    function paramLoadListRoleOfUserIDC() {
        return {
            pPosCode: $("#PosCode").val(),
            pTitleChoice: "",
            pFlagShow: "3"
        };
    }

    function paramLoadListEntityOfUserIDC() {
        return {
            pPosCode: $("#PosCode").val(),
            pTitleChoice: "",
            pFlagShow: "2"
        };
    }

    // function Change_PosCode() {
    //     var objProvinceCode = $("#ProvinceCode").data("kendoComboBox");
    //     var objCommuneCode = $("#CommuneCode").data("kendoComboBox");
    //     var objSubCommuneCode = $("#AddressCode").data("kendoComboBox");

    //     if (objProvinceCode != null) {
    //         objProvinceCode.dataSource.read();
    //     }
    //      // Gọi action Read của DataSource
    //     // objCommuneCode.dataSource.read(); // Gọi action Read của DataSource
    //     // objSubCommuneCode.dataSource.read(); // Gọi action Read của DataSource
    // }

    function Change_PosCode() {
        var objProvinceCode = $("#ProvinceCode").data("kendoComboBox");
        var objCommuneCode = $("#CommuneCode").data("kendoComboBox");
        var objSubCommuneCode = $("#AddressCode").data("kendoComboBox");

        objProvinceCode.dataSource.read().then(function () {
            objProvinceCode.select(1);
        });

        // objCommuneCode.dataSource.read().then(function () {
        //     objCommuneCode.select(0);
        // });

        // objSubCommuneCode.dataSource.read().then(function () {
        //     objSubCommuneCode.select(0);
        // });
    }

    var roleLists;
    function Change_RoleOfUserIDC() {
        var objGroupId = $("#GroupName").data("kendoComboBox");
        if (objGroupId != null) {
            var lcGroupNameText = objGroupId.text();
            $("#GroupNameText").val(lcGroupNameText);

            $.ajax({
                type: "GET",
                data: {
                    pUserRole: objGroupId.value()
                },
                url: "../ListOfValue/GetRoleToTransferCashByUserRole",
                success: function (data) {
                    roleLists = data;
                    if (roleLists != null && roleLists.length != 0) {
                        $("#RoleToTransferCashDescription").val(roleLists[0].RoleToTransferCashDescription);
                        $("#RoleToTransferCashValue").val(roleLists[0].RoleToTransferCashValue);
                        //Set AuthsecType
                        var comboAuth = $("#AuthsecType").data("kendoComboBox");
                        if (comboAuth) {
                            if (roleLists[0].RoleToTransferCashValue === "Y") {
                                comboAuth.value("17");
                            } else {
                                comboAuth.value("0");
                            }
                            comboAuth.readonly(true);
                        }

                        var comboMailFlag = $("#MailIdFlag").data("kendoComboBox");
                        if (comboMailFlag) {
                            comboMailFlag.readonly(true);
                        }
                    }
                }
            });
        }
    }

    var staffLists;
    function LoadStaffInfoDetail(e) {
        var objStaffId = $("#StaffId").data("kendoComboBox");
        var lcUserId = $("#UserId").val();
        var lcFirstName = $("#FirstName").val();
        var lcLastName = $("#LastName").val();
        if (objStaffId != null) {
            var lcStaffId = $("#StaffId").val(); // Lấy ID của thành viên =>Load thông tin ra theo ID này
            if (lcStaffId != null && lcStaffId != "" && lcStaffId != "0") {
                $.ajax({
                    type: "GET",
                    data: {
                        pStaffId: lcStaffId
                    },
                    url: "../ListOfValue/GetListStaffVBSPByStaffId",
                    success: function (data) {
                        staffLists = data;
                        if (staffLists != null && staffLists.length != 0) {
                            $("#UserId").val(staffLists[0].StaffCode);
                            var lcFullName = staffLists[0].StaffName.trim();
                            var nameParts = lcFullName.split(/\s+/);
                            var lcLastName = nameParts.pop();
                            var lcFirstName = nameParts.join(" ");
                            $("#FirstName").val(lcFirstName);
                            $("#LastName").val(lcLastName);
                            $("#StaffCode").val(staffLists[0].StaffCode);
                            $("#Genders").val(staffLists[0].GenderText);
                            $("#DateOfBirth").val(staffLists[0].DateOfBirthText);
                            $("#PosName").val(staffLists[0].StaffPosName);
                            $("#StaffDepartmentName").val(staffLists[0].StaffDepartmentName);
                            $("#StaffPositionName").val(staffLists[0].StaffPositionName);
                            $("#MobileNumber").val(staffLists[0].StaffMobileNo);
                            $("#EmailAddress").val(staffLists[0].StaffEmail);
                            $("#StaffPosCode").val(staffLists[0].StaffPosCode);
                            $("#StaffDepartmentCode").val(staffLists[0].StaffDepartmentCode);
                            $("#StaffPositionCode").val(staffLists[0].StaffPositionCode);
                            $("#FullName").val(staffLists[0].StaffName);
                        }
                    }
                });
            }
        }
    }

    function onCloseUpdate(ev) {
        mainWindow.data("kendoWindow").close();
    }


    function Change_Status(e) {
        if (!isEditMode) return;

        var statusDDL = $("#Status").data("kendoDropDownList");
        var statusValue = statusDDL.value();

        if (statusValue === "0") {
            var expirePicker = $("#ExpiryDate").data("kendoDatePicker");
            if (expirePicker) {

                expirePicker.value(new Date());
                expirePicker.enable(true);
            }
        }
    }

    function stringToDate(_date, _format, _delimiter) {
        var formatLowerCase = _format.toLowerCase();
        var formatItems = formatLowerCase.split(_delimiter);
        var dateItems = _date.split(_delimiter);
        var monthIndex = formatItems.indexOf("mm");
        var dayIndex = formatItems.indexOf("dd");
        var yearIndex = formatItems.indexOf("yyyy");
        var month = parseInt(dateItems[monthIndex]);
        month -= 1;
        var formatedDate = new Date(dateItems[yearIndex], month, dateItems[dayIndex]);
        return formatedDate;
    }

    function onClick(e) {
        var lcPosCode = $("#PosCode").val();
        var lcStaffId = $("#StaffId").val();
        var lcStaffCode = $("#StaffCode").val();
        var lcFullName = $("#FullName").val();
        
        if (lcPosCode == null || lcPosCode == "" || lcPosCode == "0" || lcPosCode == "000000") {
            alert("Bạn chưa chọn đơn vị của người dùng cần tạo mới tài khoản người dùng Intellect iDC. Bạn vui lòng kiểm tra lại!");
            $('#PosCode').focus();
            e.preventDefault();
            return false;
        }
        if (lcStaffId == null || lcStaffId == "") {
            alert('Bạn chưa chọn cán bộ cần tạo mới càn tài khoản người Intellect iDC. Bạn vui lòng kiểm tra lại!');
            $('#StaffId').focus();
            e.preventDefault();
            return false;
        }
        if (lcStaffCode == null || lcStaffCode == "") {
            alert("Cán bộ [" + lcFullName + "] có mã cán bộ trống. Bạn vui lòng kiểm tra lại!");
            $('#StaffCode').focus();
            e.preventDefault();
            return false;
        }

        var lcEffectiveDate = $("#EffectiveDate").val();
        var dEffectiveDate = stringToDate(lcEffectiveDate, "dd/MM/yyyy", "/");
        var lcExpiryDate = $("#ExpiryDate").val();
        var dExpiryDate = stringToDate(lcExpiryDate, "dd/MM/yyyy", "/");
        var lcStartDate = $("#StartDate").val();
        var dStartDate = stringToDate(lcStartDate, "dd/MM/yyyy", "/");
        var lcBusinessDate = $("#BusinessDate").val();
        var dBusinessDate = stringToDate(lcBusinessDate, "dd/MM/yyyy", "/");
        if (dExpiryDate < dEffectiveDate) {
            alert("Tài khoản Intellect iDC của người dùng [" + lcFullName + "] cập nhật có ngày hết hiệu lực [" + lcExpiryDate + "] nhỏ hơn ngày hiệu lực [" + lcEffectiveDate + "]. Vui lòng kiểm tra lại!");
            $('#EffectiveDate').focus();
            e.preventDefault();
            return false;
        }
        if (dEffectiveDate < dBusinessDate) {
            alert("Tài khoản người dùng Intellect iDC cập nhật có ngày hiệu lực [" + lcEffectiveDate + "] nhỏ hơn ngày hiện tại của hệ thống Intelect iDC [" +  lcBusinessDate + "]. Vui lòng kiểm tra lại!");
            $('#EffectiveDate').focus();
            e.preventDefault();
            return false;
        }
        if (dStartDate < dBusinessDate) {
            alert("Tài khoản người dùng Intellect iDC cập nhật có ngày bắt đầu [" + lcStartDate + "] nhỏ hơn ngày hiện tại của hệ thống Intelect iDC [" +  lcBusinessDate + "]. Vui lòng kiểm tra lại!");
            $('#EffectiveDate').focus();
            e.preventDefault();
            return false;
        }

         var lcFlagCallView = $("#FlagEventCallView").val();
         if (lcFlagCallView == $("#EventFlag_AddView").val())
         {
             if (dEffectiveDate < dStartDate) {
                alert("Tài khoản người dùng Intellect iDC tạo mới ngày bắt đầu [" + lcStartDate + "] lơn hơn ngày hiệu lực [" +  lcEffectiveDate + "]. Vui lòng kiểm tra lại!");
                $('#EffectiveDate').focus();
                e.preventDefault();
                return false;
             }
         }
    }

    function setEditMode() {
        isEditMode = true;

        $("#PosCode").closest(".k-combobox").css("pointer-events", "none").addClass("readonly-field");
        $("#StaffId").closest(".k-combobox").css("pointer-events", "none").addClass("readonly-field");
        var checkInterval = setInterval(function() {
            var posCodeCombo = $("#PosCode").data("kendoComboBox");
            var staffIdCombo = $("#StaffId").data("kendoComboBox");

            if (posCodeCombo && staffCodeCombo &&
                posCodeCombo.dataSource.data().length > 0 &&
                staffIdCombo.dataSource.data().length > 0) {

                clearInterval(checkInterval);

                posCodeCombo.enable(false);
                posCodeCombo.wrapper.css("pointer-events", "none").addClass("readonly-field");

                staffIdCombo.enable(false);
                staffIdCombo.wrapper.css("pointer-events", "none").addClass("readonly-field");

                var birthdayPicker = $("#DateOfBirth").data("kendoDatePicker");
                if (birthdayPicker) {
                    birthdayPicker.enable(false);
                    birthdayPicker.wrapper.addClass("readonly-field");
                }

                var genderDDL = $("#Genders").data("kendoDropDownList");
                if (genderDDL) {
                    genderDDL.enable(false);
                    genderDDL.wrapper.addClass("readonly-field");
                }

                var masked = $("#MobileNumber").data("kendoMaskedTextBox");
                if (masked) {
                    masked.enable(false);
                    masked.wrapper.addClass("readonly-field");
                }

                var emailTextBox = $("#EmailAddress").data("kendoTextBox");
                if (emailTextBox) {
                    emailTextBox.enable(false);
                    emailTextBox.wrapper.addClass("readonly-field");
                } else {
                    $("#EmailAddress").prop('readonly', true).parent().addClass("readonly-field");
                }

                var expirePicker = $("#ExpiryDate").data("kendoDatePicker");
                if (expirePicker) {
                    expirePicker.enable(true);
                    expirePicker.wrapper.removeClass("readonly-field").addClass("editable-field");
                }
                $("#Remark").prop('readonly', false).removeClass("readonly-field").addClass("editable-field");
            }
        }, 100);

        setTimeout(function() {
            clearInterval(checkInterval);
        }, 5000);
    }

    function onMaApDungChange(e) {
        var values = this.value();

        var txt = $("#InterWardName").data("kendoTextBox");

        if (values.includes("3") || values.includes(3)) {
            txt.enable(true);
        } else {
            txt.value("");
            txt.enable(false);
        }
    }
    var lcButton = "";
</script>

