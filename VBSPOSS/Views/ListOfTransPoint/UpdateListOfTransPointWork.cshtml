                @Html.Kendo().TextBoxFor(m => m.PhoneSupport02).HtmlAttributes(new { style = " width: 160px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", placeholder = "Nhập số điện thoại" })
            </div>
        </div>

        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Trạng thái </label>
                @(Html.Kendo().ComboBoxFor(m => m.Status)
                    .Filter(FilterType.Contains)
