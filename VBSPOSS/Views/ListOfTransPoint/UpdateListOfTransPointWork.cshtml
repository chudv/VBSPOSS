    function Change_SubCommune() {
        var objProvince = $("#ProvinceCode").data("kendoComboBox");
        var objCommune = $("#CommuneCode").data("kendoComboBox");
        var objSubCommune = $("#AddressCode").data("kendoComboBox");
        var txnLocation = $("#TxnLocation").val();
        var provinceText = getNameOnly(objProvince.text());
        var communeText = getNameOnly(objCommune.text());
        var subCommuneText = getNameOnly(objSubCommune.text());
        var addressDetail = "";
        if (txnLocation) {
            addressDetail += txnLocation;
        }
        if (subCommuneText) {
            addressDetail += ", " + subCommuneText;
        }
        if (communeText) {
            addressDetail += ", " + communeText;
        }
        if (provinceText) {
            addressDetail += ", " + provinceText;
        }
        //$("#AddressDetail").val(addressDetail);
        $("#AddressDetail").data("kendoTextBox").value(addressDetail);
    }

    function getNameOnly(text) {
        if (!text) return "";
        var arr = text.split('-');
        if (arr.length > 1) {
            return arr.slice(1).join('-').trim();
        }
        return text.trim();
    }
