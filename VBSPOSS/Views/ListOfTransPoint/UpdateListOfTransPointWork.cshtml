                <label class="lbcontrol" style="width: 120px; vertical-align: bottom;color: navy;text-align:left; padding-left:0px;padding-right:0px;padding-top:7px; ">Mã điểm GD</label>
                @Html.Kendo().TextBoxFor(m=>m.TxnPointCode).HtmlAttributes(new {style = " width: 140px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="color: navy;text-align:right;width:100px;padding-top: 7px;padding-right: 7px;">Tên điểm GD </label>
                @Html.Kendo().TextBoxFor(m => m.TxnPointName).HtmlAttributes(new {style = " width: 150px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="color: navy;text-align:center;width:80px;padding-top: 7px;padding-right: 7px;">Ngày GD </label>
                @(Html.Kendo().NumericTextBoxFor(m => m.VisitDate)
                                .Min(1)
                                .Max(31)
                                .Format("n0")
                                .HtmlAttributes(new
                                {
                                    style = "width:90px;color:blue;"
                                }))
                <label class="lbcontrol" style="width: 100px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Thời gian GD</label>
                @Html.Kendo().TimePickerFor(m => m.TimeBeginDate).HtmlAttributes(new { style = "width: 100px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                @Html.Kendo().TimePickerFor(m => m.TimeEndDate).HtmlAttributes(new { style = "width: 100px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
            </div>
        </div>

        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="display: inline-flex;">
                <label class="lbcontrol" style="width: 120px; vertical-align: bottom;color: navy;text-align:left; padding-left:0px;padding-right:0px;padding-top:7px; ">Địa điểm GD</label>
                 @(Html.Kendo().ComboBoxFor(model => model.MaApDungList)
                                .Placeholder("--- Chọn nơi giao dịch ---")
                                .Filter(FilterType.Contains)
                                .HtmlAttributes(new
                                {
                                    style = "width: 400px; max-width: 100%; color: navy; font-family:Tahoma;"
                                })
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .BindTo(new List<SelectListItem>
                                {
                                new SelectListItem { Text = "Giao dịch tại xã", Value = "1" },
                                new SelectListItem { Text = "Giao dịch tại Ngân hàng", Value = "2" }
                                }))
                <label class="lbcontrol" style="color: navy;text-align:right;width:140px;padding-top: 7px;padding-right: 7px;">Điểm liên phường</label>
                <input type="checkbox" id="chkInterWard" onchange="onInterWardCheck()" />
                <label class="lbcontrol" style="color: navy;text-align:right;width:10px;padding-top: 7px;padding-right: 7px;"></label>
                @Html.Kendo().TextBoxFor(m => m.InterWardName).Placeholder("--- Nhập tên điểm liên phường ---").HtmlAttributes(new { style = " width: 300px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", disabled = "disabled" })
            </div>
        </div>
        
        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Địa chỉ điểm GD </label>
                @(Html.Kendo().ComboBoxFor(m => m.ProvinceCode)
                                .Filter(FilterType.Contains)
                                .Placeholder("--- Tỉnh/Thành phố ---")
                                .DataTextField("value")
                                .DataValueField("id")
                                .DataSource(source => { source.Read(read => { read.Action("GetListProvinces", "ListOfValue").Data("paramLoadListProvince"); }).ServerFiltering(false); })
                                .HtmlAttributes(new { style = "width: 190px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px; !important;max-width: 100% !important;color: green;!important; class='form - control';" })
                                .Events(e => e.Change("Change_Province"))
                                .Suggest(true)
                                .AutoBind(true))
                <label class="lbcontrol" style="color: navy;text-align:right;width:10px;padding-top: 7px;padding-right: 7px!important;"></label>
                @(Html.Kendo().ComboBoxFor(m => m.CommuneCode)
                                .Filter(FilterType.Contains)
                                .Placeholder("--- Xã/Phường ---")
                                .DataTextField("value")
                                .DataValueField("id")
                                .ClearButton(false)
                                .DataSource(source => { source.Read(read => { read.Action("GetListCommunes", "ListOfValue").Data("paramLoadListCommune"); }).ServerFiltering(false); })
                                .HtmlAttributes(new { style = "width: 180px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px; !important;max-width: 100% !important;color: green;!important; class='form - control';" })
                                .Events(e => e.Change("Change_Commune"))
                                .Suggest(true)
                                .AutoBind(true))
                @(Html.Kendo().ComboBoxFor(m => m.AddressCode)
                                .Filter(FilterType.Contains)
                                .Placeholder("--- Thôn/Bản ---")
                                .DataTextField("value")
                                .DataValueField("id")
                                .ClearButton(false)
                                .DataSource(source => { source.Read(read => { read.Action("GetListSubCommunes", "ListOfValue").Data("paramLoadListSubCommune"); }).ServerFiltering(false); })
                                .HtmlAttributes(new { style = "width: 180px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px; !important;max-width: 100% !important;color: green;!important; class='form - control';" })
                                //.Events(e => e.Change("Change_SubCommune"))
                                .Suggest(true)
                                .AutoBind(true))
                <label class="lbcontrol" style="color: navy;text-align:left;width:10px;padding-top: 7px;padding-right: 7px;"> </label>
                @Html.Kendo().TextBoxFor(m => m.TxnLocation).HtmlAttributes(new { style = " width: 290px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", placeholder = "Nhập nơi đặt điểm giao dịch", onchange = "Change_SubCommune()" })

            </div>
        </div>
        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Địa chỉ chi tiết </label>
                @Html.Kendo().TextBoxFor(m => m.AddressDetail).HtmlAttributes(new { style = " width: 860px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", placeholder = "Địa chỉ chi tiết điểm giao dịch" })
            </div>
        </div>

        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Tọa độ điểm GD </label>
                @(Html.Kendo().NumericTextBoxFor(m => m.Longitude).Decimals(8).Format("n8").Min(-180).Max(180).HtmlAttributes(new { style = "width:120px;max-width:100%;color:blueviolet;font-family:Tahoma;padding-left:2px;padding-right:2px;", placeholder = "Nhập kinh độ" }))
                @(Html.Kendo().NumericTextBoxFor(m => m.Latitude).Decimals(8).Format("n8").Min(-180).Max(180).HtmlAttributes(new { style = "width:120px;max-width:100%;color:blueviolet;font-family:Tahoma;padding-left:2px;padding-right:2px;", placeholder = "Nhập kinh độ" }))

                <label class="lbcontrol" style="color: navy;text-align:center;width:150px;padding-top: 7px;padding-right: 7px;">Số điện thoại liên hệ</label>
                @(Html.Kendo().MaskedTextBoxFor(m => m.PhoneSupport).Mask("0000 000 000").HtmlAttributes(new{data_validmask_msg = "Giá trị không hợp lệ",placeholder = "Số điện thoại 1",style = "width:150px;max-width:100%;color:blue;padding-left:2px;padding-right:0px;"}))
                <label class="lbcontrol" style="color: navy;text-align:center;width:10px;padding-top: 7px;padding-right: 7px;"> </label>
                @(Html.Kendo().MaskedTextBoxFor(m => m.PhoneSupport01).Mask("0000 000 000").HtmlAttributes(new { data_validmask_msg = "Giá trị không hợp lệ", placeholder = "Số điện thoại 2", style = "width:150px;max-width:100%;color:blue;padding-left:2px;padding-right:0px;" }))
                <label class="lbcontrol" style="color: navy;text-align:center;width:10px;padding-top: 7px;padding-right: 7px;"></label>
                @(Html.Kendo().MaskedTextBoxFor(m => m.PhoneSupport02).Mask("0000 000 000").HtmlAttributes(new { data_validmask_msg = "Giá trị không hợp lệ", placeholder = "Số điện thoại 3", style = "width:150px;max-width:100%;color:blue;padding-left:2px;padding-right:0px;" }))
            </div>
        </div>

        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Trạng thái </label>      
                @(Html.Kendo().ComboBoxFor(m => m.TxnStatus)
                    .Filter(FilterType.Contains)
                    .Placeholder("--- Trạng thái điểm giao dịch ---")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>() {
                        new SelectListItem() { Text = "Mở (Hoạt động)", Value = "A" },
                        new SelectListItem() { Text = "Đóng (Đánh dấu xóa)", Value = "C" }
                        })
                    .Suggest(true)
                    .AutoBind(true)
                    .HtmlAttributes(new { style = "padding-left: 3px;width: 300px; color: blue;", })
                    .Events(e => e.Change("Change_Status"))
                    .SelectedIndex(0)
                    )

                <label class="lbcontrol" style="width: 150px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Ngày thành lập</label>
                @Html.Kendo().DatePickerFor(m => m.EffectiveDate).Format("dd/MM/yyyy").HtmlAttributes(new { style = "width: 130px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                <label class="lbcontrol" style="width: 150px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Ngày hiệu lực</label>
                @Html.Kendo().DatePickerFor(m => m.BusinessDate).Format("dd/MM/yyyy").Min(DateTime.Today).HtmlAttributes(new { style = "width: 130px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })

            </div>
        </div>

        <div class="row" style="padding-top: 10px; padding-left: 0px; padding-bottom: 10px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="width: 140px; vertical-align: middle;color: navy;text-align:left;">Ghi chú (nếu có)</label>
                @Html.TextAreaFor(m => m.Remark, new { @class = "k-textbox", style = "padding-left: 5px;min-height:50px;width:830px;max-width:100%;color: blue;font-family:Tahoma !important;", rows = "2" })
            </div>
        </div>

        <div class="row" style="padding-top: 13px; padding-left: 10px; padding-bottom: 0px;">
            <div class="col-md-12" style="width:100%; display:flex; justify-content:flex-end;">
                <label class="control-label" id="lblMessageInfor" style="width: 750px; text-align: left; color: red;"></label>
                &nbsp;&nbsp;
                @(Html.Kendo().Button()
                    .Name("btnSaveCreateTranspoint")
                    .Events(ev => ev.Click("onClick"))
                    .HtmlAttributes(new { type = "submit", style = "width: 90px; font-weight:bold; color: blue;height: 25px;", title = "Cập nhật thông tin tài khoản người dùng Intellect iDC" })
                    .ImageUrl(Url.Content("~/images/save.png"))
                    .Content("Lưu lại"))
                &nbsp;
                @(Html.Kendo().Button().Name("btnThoat").Events(ev => ev.Click("onCloseUpdate")).HtmlAttributes(new { type = "button", style = "height: 25px;width: 100px; font-weight:bold; color: blue;", title = "Đóng lại màn hình cập nhật thông tin" }).ImageUrl(Url.Content("~/images/close_icon.gif")).Content("Quay ra"))
            </div>
        </div>

    </div>

</form>

