    function Change_SubCommune() {
        var objProvince = $("#ProvinceCode").data("kendoComboBox");
        var objCommune = $("#CommuneCode").data("kendoComboBox");
        var objSubCommune = $("#AddressCode").data("kendoComboBox");
        var txnLocation = $("#TxnLocation").val();
        var provinceText = getNameOnly(objProvince.text());
        var communeText = getNameOnly(objCommune.text());
        var subCommuneText = getNameOnly(objSubCommune.text());
        var addressDetail = "";
        if (txnLocation) {
            addressDetail += txnLocation;
        }
        if (subCommuneText) {
            addressDetail += ", " + subCommuneText;
        }
        if (communeText) {
            addressDetail += ", " + communeText;
        }
        if (provinceText) {
            addressDetail += ", " + provinceText;
        }
        //$("#AddressDetail").val(addressDetail);
        $("#AddressDetail").data("kendoTextBox").value(addressDetail);
    }

    function getNameOnly(text) {
        if (!text) return "";
        var arr = text.split('-');
        if (arr.length > 1) {
            return arr.slice(1).join('-').trim();
        }
        return text.trim();
    }
    var lcButton = "";

    function LoadTranspointInfoDetail(e) {
        var lcPosCode = $("#PosCode").val();
        var lcTxnPointCode = $("#TxnPointCode").val();
        if (lcPosCode != null && lcTxnPointCode != null) {
            if (lcTxnPointCode != null && lcTxnPointCode != "" && lcTxnPointCode != "0") {
                $.ajax({
                    type: "GET",
                    data: {
                        pPosCode: lcPosCode,
                        pTxnPointCode: lcTxnPointCode
                    },
                    url: "../ListOfTranspoint/LoadGridData_TransPoint",
                    success: function (data) {
                        transpointLists = data;
                        if (transpointLists != null && transpointLists.length != 0) {
                            var item = transpointLists.Data[0];
                            $("#PosCodeOld").val(item.PosCode + " - " + item.PosName);
                            $("#TxnPointCodeOld").val(item.TxnPointCode + " - " + item.TxnPointName);
                            var maApDung = [];
                            if (item.IsInCommune) {
                                maApDung.push("Giao dịch tại xã");
                            }
                            else if (item.IsInPos) {
                                maApDung.push("Giao dịch tại Ngân hàng");
                            }
                            $("#MaApDungListOld").val(maApDung);
                            $("#InterWardNameOld").val(item.InterWardName);
                            $("#VisitDateOld").val(item.VisitDate);
                            $("#TimesOld").val(item.Times);
                            $("#AddressDetailOld").val(item.AddressDetail);
                            $("#LongitudeOld").val(item.Longitude);
                            $("#LatitudeOld").val(item.Latitude);
                            $("#PhoneSupportOld").val(item.PhoneSupport);
                            $("#PhoneSupport01Old").val(item.PhoneSupport01);
                            $("#PhoneSupport02Old").val(item.PhoneSupport02);
                            $("#TxnStatusOld").val(
                                item.TxnStatus === "A" ? "Mở" :
                                item.TxnStatus === "C" ? "Đóng" : ""
                            );
                            if (!item.BusinessDate) {
                                item.BusinessDate = item.EffectiveDate;
                            }
                            var effectiveDate = kendo.toString(new Date(item.EffectiveDate),"dd/MM/yyyy");
                            var businessDate = kendo.toString(new Date(item.BusinessDate),"dd/MM/yyyy");

                            $("#BusinessDateOld").val(businessDate);
                            $("#EffectiveDateOld").val(effectiveDate);
                        }
                    }
                });
            }
        }
    }

    function Change_EventCode() {
        var objEventCode = $("#EventCode").data("kendoComboBox");
