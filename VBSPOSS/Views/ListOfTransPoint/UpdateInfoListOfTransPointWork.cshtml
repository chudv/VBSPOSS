                <div class="col-md-12" style="display: inline-flex;">
                    <label class="lbcontrol" style="color: maroon;text-align:left;width:600px;padding-top: 5px;">Thông tin thay đổi điểm giao dịch</label>
                    <label class="lbcontrol" style="color: navy;text-align:right;width:150px;padding-top: 7px;padding-right: 10px!important;">Trạng thái bản ghi</label>
                    @Html.Kendo().TextBoxFor(m => m.StatusText).HtmlAttributes(new { @readonly = "readonly", style = " width: 190px; !important;max-width:100% !important;color: blueviolet;font-family:Tahoma;padding-left: 2px!important;padding-right: 2px!important;" })
                </div>
            </div>
            <div class="row" style="padding-top: 7px; padding-left: 10px; padding-bottom: 10px;">
