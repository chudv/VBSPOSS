        $("#ckb_EndDateChangeRole").hide();
        $("#lblEndDateChangeRole").hide();
        $("#EndDateChangeRole").closest(".k-datepicker").hide();
        var lcEventCode = $("#EventCode").val();
        if(lcEventCode == $("#EventCode_TransPoint_Change_VisitDateView").val())
        {
            $("#divVisitDate").show();
            $("#divTranspointName").hide();
            $("#divOther").hide();
        }
        else if (lcEventCode == $("#EventCode_TransPoint_Change_NameView").val()) {
            $("#divVisitDate").hide();
            $("#divTranspointName").show();
            $("#divOther").hide();
        }
        else if (lcEventCode == $("#EventCode_TransPoint_Change_OtherInforView").val()) {
            $("#divVisitDate").hide();
            $("#divTranspointName").hide();
            $("#divOther").show();
        }
