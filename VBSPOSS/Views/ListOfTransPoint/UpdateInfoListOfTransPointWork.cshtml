                                        .DataTextField("Description")
                                        .DataValueField("Code")
                                        .BindTo((List<ValueConstModel>)ViewBag.EventCode)
                                        .Placeholder("Chọn nghiệp vụ yêu cầu")
                                        .HtmlAttributes(new { style = "width: 320px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px;max-width: 100% !important;color: green;" })
                                        .Filter("contains")
                                        .Events(e => e.Change("Change_EventCode"))
                                        .SelectedIndex(0))
                    <label class="lbcontrol" style="width: 110px; vertical-align: bottom;color: navy;text-align:right;padding-top:7px;padding-right:10px;">Ngày bắt đầu</label>
                    @Html.Kendo().DatePicker().Name("BusinessDateNew").Format("dd/MM/yyyy").Min(DateTime.Today).Value(DateTime.Today).HtmlAttributes(new { style = "width: 120px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                    <label id="lblEndDateChangeRole" class="lbcontrol" style="width: 110px; vertical-align: bottom;color: navy;text-align:right;padding-top:7px;padding-right:5px;">Ngày kết thúc</label>
                    @(Html.Kendo().CheckBox().Name("ckb_EndDateChangeRole").Label(" ").HtmlAttributes(new { onchange = "Checked_EndDateChangeRole();", style = "color: red;text-align: center;padding-right: 5px;", title = "Tích chọn nếu muốn đổi quyền từ ngày đến ngày" }))
                    @Html.Kendo().DatePickerFor(m => m.EndDateChangeRole).Format("dd/MM/yyyy").Min(DateTime.Today).HtmlAttributes(new { style = "width: 120px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                </div>
            </div>

            <div id="divVisitDate" class="row" style="padding-top: 10px; padding-left: 10px; padding-bottom: 10px;">
                <div class="col-md-12" style="display: inline-flex;">
                    <label class="lbcontrol" style="color: navy;text-align:left;width:140px;padding-top: 7px;">Ngày giao dịch mới</label>
                    @(Html.Kendo().NumericTextBoxFor(m => m.VisitDate).Min(1).Max(31).Format("n0").HtmlAttributes(new{style = "width:150px;color:blue;"}))
                </div>
            </div>

            <div id="divTranspointName" class="row" style="padding-top: 5px; padding-left: 10px; padding-bottom: 5px;">
                <div class="col-md-12" style="display: inline-flex;">
                    <label class="lbcontrol" style="width: 140px; vertical-align: bottom;color: navy;text-align:left; padding-left:0px;padding-right:10px;padding-top:7px;">Tên điểm giao dịch</label>
                    @(Html.Kendo().TextBoxFor(m => m.TxnPointName).HtmlAttributes(new { placeholder = "Tên điểm giao dịch mới", style = "width: 550px; !important;max-width:100% !important;color: blue;font-family:Tahoma !important;padding-left: 2px!important;padding-right: 0px!important;" }))
                </div>
            </div>

            <div id="divOther" class="row" style="padding-top: 5px; padding-left: 10px; padding-bottom: 5px;">
                <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                    <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Địa chỉ điểm GD </label>
                    @(Html.Kendo().ComboBoxFor(m => m.ProvinceCode)
                                        .Filter(FilterType.Contains)
                                        .Placeholder("--- Tỉnh/Thành phố ---")
                                        .DataTextField("value")
                                        .DataValueField("id")
                                        .DataSource(source => { source.Read(read => { read.Action("GetListProvinces", "ListOfValue").Data("paramLoadListProvince"); }).ServerFiltering(false); })
                                        .HtmlAttributes(new { style = "width: 190px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px; !important;max-width: 100% !important;color: green;!important; class='form - control';" })
                                        .Events(e => e.Change("Change_Province"))
                                        .Suggest(true)
                                        .AutoBind(true))
                    <label class="lbcontrol" style="color: navy;text-align:right;width:10px;padding-top: 7px;padding-right: 7px!important;"></label>
                    @(Html.Kendo().ComboBoxFor(m => m.CommuneCode)
                                        .Filter(FilterType.Contains)
                                        .Placeholder("--- Xã/Phường ---")
                                        .DataTextField("value")
                                        .DataValueField("id")
                                        .ClearButton(false)
                                        .DataSource(source => { source.Read(read => { read.Action("GetListCommunes", "ListOfValue").Data("paramLoadListCommune"); }).ServerFiltering(false); })
                                        .HtmlAttributes(new { style = "width: 180px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px; !important;max-width: 100% !important;color: green;!important; class='form - control';" })
                                        .Events(e => e.Change("Change_Commune"))
                                        .Suggest(true)
                                        .AutoBind(true))
                    @(Html.Kendo().ComboBoxFor(m => m.AddressCode)
                                        .Filter(FilterType.Contains)
                                        .Placeholder("--- Thôn/Bản ---")
                                        .DataTextField("value")
                                        .DataValueField("id")
                                        .ClearButton(false)
                                        .DataSource(source => { source.Read(read => { read.Action("GetListSubCommunes", "ListOfValue").Data("paramLoadListSubCommune"); }).ServerFiltering(false); })
                                        .HtmlAttributes(new { style = "width: 180px;padding-top: 0px;padding-bottom: 0px;padding-top: 0px;padding-left: 3px;padding-right: 2px; !important;max-width: 100% !important;color: green;!important; class='form - control';" })                                                                                                                                                                                                                                                                           //.Events(e => e.Change("Change_SubCommune"))
                                        .Suggest(true)
                                        .AutoBind(true))
                    <label class="lbcontrol" style="color: navy;text-align:left;width:5px;padding-top: 7px;padding-right: 7px;"> </label>
                    @Html.Kendo().TextBoxFor(m => m.TxnLocation).HtmlAttributes(new { style = " width: 250px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", placeholder = "Nhập nơi đặt điểm giao dịch", onchange = "Change_SubCommune()" })
                </div>
                <div class="col-md-12" style="vertical-align: bottom; color: navy; padding-top: 10px;padding-bottom: 10px">
                    <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Địa chỉ chi tiết </label>
                    @Html.Kendo().TextBoxFor(m => m.AddressDetail).HtmlAttributes(new { style = " width: 800px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", placeholder = "Địa chỉ chi tiết điểm giao dịch" })
                </div>
                <div class="col-md-12" style="vertical-align: bottom; color: navy;padding-top: 10px; padding-bottom: 10px ">
                    <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Tọa độ điểm GD </label>
                    @(Html.Kendo().NumericTextBoxFor(m => m.Longitude).Decimals(8).Format("n8").Min(-180).Max(180).HtmlAttributes(new { style = "width:120px;max-width:100%;color:blueviolet;font-family:Tahoma;padding-left:2px;padding-right:2px;", placeholder = "Nhập kinh độ" }))
                    @(Html.Kendo().NumericTextBoxFor(m => m.Latitude).Decimals(8).Format("n8").Min(-180).Max(180).HtmlAttributes(new { style = "width:120px;max-width:100%;color:blueviolet;font-family:Tahoma;padding-left:2px;padding-right:2px;", placeholder = "Nhập kinh độ" }))
                    <label class="lbcontrol" style="width: 100px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Thời gian GD</label>
                    @Html.Kendo().TimePickerFor(m => m.TimeBeginDate).HtmlAttributes(new { style = "width: 100px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                    @Html.Kendo().TimePickerFor(m => m.TimeEndDate).HtmlAttributes(new { style = "width: 100px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                    <label class="lbcontrol" style="width: 150px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Ngày thành lập</label>
                    @Html.Kendo().DatePickerFor(m => m.EffectiveDate).Format("dd/MM/yyyy").HtmlAttributes(new { style = "width: 130px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
                </div>
            </div>

            <div class="row" style="padding-top: 5px; padding-left: 10px; padding-bottom: 5px;">
                <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                    <label class="lbcontrol" style="width: 120px; vertical-align: top;color: navy;text-align:left;padding-top: 7px;">Ghi chú</label>
                    @Html.TextAreaFor(m => m.Remark, new { @class = "k-textbox", style = "padding-top: 5px;min-height:30px; width:800px;max-width:100%;color: blue;font-family:Tahoma !important;", rows = "2", placeholder = "Ghi chú nghiệp vụ yêu cầu thay đổi" })
                </div>
            </div>
        </div>


        <div class="row" style="padding-top: 13px; padding-left: 10px; padding-bottom: 0px;">
            <div class="col-md-12" style="width:100%; display:flex; justify-content:flex-end;">
                <label class="control-label" id="lblMessageInfor" style="width: 750px; text-align: left; color: red;"></label>
                &nbsp;&nbsp;
                @(Html.Kendo().Button()
                    .Name("btnSaveCreateTranspoint")
                    .Events(ev => ev.Click("onClick"))
                    .HtmlAttributes(new { type = "submit", style = "width: 90px; font-weight:bold; color: blue;height: 25px;", title = "Cập nhật thông tin tài khoản người dùng Intellect iDC" })
                    .ImageUrl(Url.Content("~/images/save.png"))
                    .Content("Lưu lại"))
                &nbsp;
                @(Html.Kendo().Button().Name("btnThoat").Events(ev => ev.Click("onCloseUpdate")).HtmlAttributes(new { type = "button", style = "height: 25px;width: 100px; font-weight:bold; color: blue;", title = "Đóng lại màn hình cập nhật thông tin" }).ImageUrl(Url.Content("~/images/close_icon.gif")).Content("Quay ra"))
            </div>
        </div>

    </div>

</form>

