            <div class="col-md-12" style="display: inline-flex;">
                <label class="lbcontrol" style="color: maroon;text-align:left;width:500px;padding-top: 7px;">Thông tin hiện tại của điểm giao dịch</label>
            </div>
        </div>
        <div style="color: navy; padding-top: 0px;" class="row">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="width: 120px;color: navy;text-align:left;padding-top: 7px;">Đơn vị điểm GD</label>
                @Html.Kendo().TextBox().Name("PosCodeOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 370px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="color: navy;text-align:right;width:100px;padding-top: 7px;padding-right: 7px;">Tên điểm GD </label>
                @Html.Kendo().TextBox().Name("TxnPointCodeOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 350px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
            </div>
        </div>

        <div class="row" style="padding-top: 05px; padding-left: 0px; padding-bottom: 05px;">
            <div class="col-md-12" style="display: inline-flex;">
                <label class="lbcontrol" style="width: 120px; vertical-align: bottom;color: navy;text-align:left; padding-left:0px;padding-right:0px;padding-top:7px; ">Địa điểm GD</label>
                @Html.Kendo().TextBox().Name("MaApDungListOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 250px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="color: navy;text-align:right;width:100px;padding-top: 7px;padding-right: 7px;">Liên phường </label>
                @Html.Kendo().TextBox().Name("InterWardNameOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 100px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="color: navy;text-align:center;width:80px;padding-top: 7px;padding-right: 7px;">Ngày GD </label>
                @Html.Kendo().TextBox().Name("VisitDateOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 80px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="width: 100px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Thời gian GD</label>
                @Html.Kendo().TextBox().Name("TimesOld").HtmlAttributes(new { @readonly = "readonly", style = "width: 110px;max-width:100%;font-family:Tahoma;color: blue;padding-left: 3px;padding-right: 3px;" })
            </div>
        </div>

        <div class="row" style="padding-top: 05px; padding-left: 0px; padding-bottom: 05px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Địa chỉ điểm GD </label>
                @Html.Kendo().TextBox().Name("AddressDetailOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 820px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;", placeholder = "Địa chỉ chi tiết điểm giao dịch" })
            </div>
        </div>

        <div class="row" style="padding-top: 05px; padding-left: 0px; padding-bottom: 05px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Tọa độ điểm GD </label>
                @(Html.Kendo().TextBox().Name("LongitudeOld").HtmlAttributes(new { @readonly = "readonly", style = "width:110px;max-width:100%;color:blueviolet;font-family:Tahoma;padding-left:2px;padding-right:2px;", placeholder = "Nhập kinh độ" }))
                @(Html.Kendo().TextBox().Name("LatitudeOld").HtmlAttributes(new { @readonly = "readonly", style = "width:110px;max-width:100%;color:blueviolet;font-family:Tahoma;padding-left:2px;padding-right:2px;", placeholder = "Nhập kinh độ" }))
                <label class="lbcontrol" style="color: navy;text-align:center;width:150px;padding-top: 7px;padding-right: 7px;">Số điện thoại liên hệ</label>
                @(Html.Kendo().TextBox().Name("PhoneSupportOld").HtmlAttributes(new { @readonly = "readonly", style = "width:150px;max-width:100%;color:blue;padding-left:2px;padding-right:0px;" }))
                <label class="lbcontrol" style="color: navy;text-align:center;width:10px;padding-top: 7px;padding-right: 7px;"> </label>
                @(Html.Kendo().TextBox().Name("PhoneSupport01Old").HtmlAttributes(new { @readonly = "readonly", style = "width:140px;max-width:100%;color:blue;padding-left:2px;padding-right:0px;" }))
                <label class="lbcontrol" style="color: navy;text-align:center;width:10px;padding-top: 7px;padding-right: 7px;"></label>
                @(Html.Kendo().TextBox().Name("PhoneSupport02Old").HtmlAttributes(new { @readonly = "readonly", style = "width:140px;max-width:100%;color:blue;padding-left:2px;padding-right:0px;" }))
            </div>
        </div>

        <div class="row" style="padding-top: 05px; padding-left: 0px; padding-bottom: 05px;">
            <div class="col-md-12" style="vertical-align: bottom; color: navy;">
                <label class="lbcontrol" style="color: navy;text-align:left;width:120px;padding-top: 7px;padding-right: 7px;">Trạng thái </label>      
                @Html.Kendo().TextBox().Name("TxnStatusOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 100px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;" })
                <label class="lbcontrol" style="width: 150px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Ngày thành lập</label>
                @Html.Kendo().TextBox().Name("EffectiveDateOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 200px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;text-align:center;" })
                <label class="lbcontrol" style="width: 150px; vertical-align: bottom;color: navy;text-align:center;padding-top:7px;">Ngày hiệu lực</label>
                @Html.Kendo().TextBox().Name("BusinessDateOld").HtmlAttributes(new { @readonly = "readonly", style = " width: 200px;max-width:100%;color: blueviolet;font-family:Tahoma;padding-left: 2px;padding-right: 2px;text-align:center;" })
            </div>
        </div>

        <hr style='margin-top: 1.1em; margin-bottom: 0.3em; padding-top: 0px; background-color: #333; border-width: 0; color: #000000; height: 1px; line-height: 0; text-align: left; width: 100%; background-image: linear-gradient(to right, #ccc, #333, #ccc); ' />
