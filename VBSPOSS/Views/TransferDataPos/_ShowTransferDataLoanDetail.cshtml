@model List<VBSPOSS.ViewModels.ChangePosDataCheckingViewModel>

@using Kendo.Mvc.UI


<style>
    #gridMainTransPointWork div a, table tr, td {
        font-size: 12px;
    }

    .btn-view-edit,
    .btn-delete {
        padding: 0 2px !important;
        min-width: 20px !important;
    }

    #gridMainTransPointWork .k-grid td {
        border-right: 1px solid #ddd !important;
    }


    #gridMainTransPointWork .k-grid-header th {
        border-right: 1px solid #ddd !important;
    }

    .k-grid-header .k-header > .k-link {
        font-family: Tahoma !important;
        font-weight: bold !important;
        color: navy;
    }

    #Status_Find .k-input *, .k-input *::before, .k-input *::after, .k-picker *, .k-picker *::before, .k-picker *::after {
        box-sizing: border-box;
        padding-top: 3px;
        padding-bottom: 0px;
        height: 23px;
    }

    .k-grid .k-grid-header .k-header .k-link {
        height: auto;
    }

    .k-grid .k-grid-header .k-header {
        overflow: visible !important;
        white-space: normal !important;
        vertical-align: middle;
        text-align: center;
    }

    .k-column-title {
        min-width: 0;
        text-overflow: ellipsis;
        white-space: normal;
        flex-shrink: 1;
        overflow: hidden;
        text-wrap: auto;
    }

    .k-grid th, .k-grid td {
        font-family: tahoma;
        color: navy;
    }

    .k-grid * {
        padding-top: 2px;
        padding-bottom: 2px;
    }

    red {
        color: red;
    }

    green {
        color: green;
    }

    .style0 {
        font-weight: bold;
        color: blueviolet;
    }

    .style1 {
        font-weight: bold;
        color: blueviolet;
    }

    .style2 {
        font-style: italic;
    }

    .style3 {
    }

    .style4 {
        font-weight: bold;
        font-style: italic;
    }

    .style5 {
        text-decoration: underline;
    }

    .k-dropdown .k-dropdown-wrap {
        height: 21px;
        padding-top: 2px;
        padding-bottom: 2px;
    }

    .k-grid .btn-view.k-button {
        background: url('../images/icon_view.png') no-repeat center center;
        background-size: 15px 15px;
        width: 15px;
        height: 15px;
        border: none;
    }

    .k-grid .btn-view-edit.k-button {
        background: url('../images/icon_edit.png') no-repeat center center;
        background-size: 15px 15px;
        width: 15px;
        height: 15px;
        border: none;
    }

    .k-grid .btn-delete.k-button {
        background: url('../images/icon_delete.png') no-repeat center center;
        background-size: 15px 15px;
        width: 15px;
        height: 15px;
        border: none;
    }

    .k-grid .btn-auth.k-button {
        background: url('../images/icon_auth.png') no-repeat center center;
        background-size: 15px 15px;
        width: 15px;
        height: 15px;
        border: none;
    }

    .k-grid .btn-approval.k-button {
        background: url('../images/icon_approval.png') no-repeat center center;
        background-size: 15px 15px;
        width: 15px;
        height: 15px;
        border: none;
    }

    .k-grid .btn-EditIDC.k-button {
        background: url('../images/sua_doi.png') no-repeat center center;
        background-size: 15px 15px;
        width: 15px;
        height: 15px;
        border: none;
    }

    .k-dropdown .k-dropdown-wrap {
        height: 21px;
    }
</style>

<script>

    function paramLoadFromPos() {
        return {
            pFromPos: '@ViewBag.PFromPos',

        };
    }

    function paramLoadGridData() {
        return {
            pId: '@ViewBag.PId',
            pFromPos: '@ViewBag.PFromPos',
            pToPos: '@ViewBag.PToPos',
            pSourceTarget: '@ViewBag.PSourceTarget',
            pFromVillages: $("#FromVillage_Find").val(),
            pToVillages: $("#ToVillage_Find").val(),
            pTextDetil: $("#Search_Text").val()
        };
    }

    function refreshGridTideRateConfigure() {
        var grid = $("#gridMainTranferTarget").data("kendoGrid");
        if (grid != null) {
            grid.dataSource.read();
        }
    }

    function onSearchLoanDetail(e) {
        refreshGridTideRateConfigure();
    }
</script>

<div class="row">
    <div class="row" style="color: navy; padding-top: 0px;padding-bottom: 0px;">
        <div class="col-md-12">
            <label class="lbcontrol"
                   style="color: navy;text-align:left;width:90px;padding-top:7px;padding-left:5px;font-family:Tahoma;font-size:12px;">
                Thôn nguồn
            </label>

            @(Html.Kendo().ComboBox()
                .Name("FromVillage_Find")
                .DataTextField("Text")
                .DataValueField("Value")
                .BindTo((List<SelectListItem>)ViewData["FromVillages"])
                .Filter(FilterType.Contains)
                .Placeholder("--- Chọn thôn nguồn ---")
                .ClearButton(false)
                .Suggest(true)
                .AutoBind(true)
                .HtmlAttributes(new
                {
                    style = "width:360px;color:green;",
                    @class = "form-control"
                })
                )

            <label class="lbcontrol"
                   style="width:85px;vertical-align:bottom;color:navy;text-align:center;padding-top:7px;">
                Thôn đích
            </label>

            @(Html.Kendo().ComboBox()
                .Name("ToVillage_Find")
                .DataTextField("Text")
                .DataValueField("Value")
                .BindTo((List<SelectListItem>)ViewData["ToVillages"])
                .Filter(FilterType.Contains)
                .Placeholder("--- Chọn thôn đích ---")
                .ClearButton(false)
                .Suggest(true)
                .AutoBind(true)
                .HtmlAttributes(new
                {
                    style = "width:360px;color:green;",
                    @class = "form-control"
                })
                )

            &nbsp;&nbsp;&nbsp;&nbsp;
            <label class="lbcontrol" style="color: navy;text-align:left;padding-top:3px;padding-right:6px;margin-left: 5px;">Nội dung</label>
            @(Html.Kendo().TextBox()
                .Name("Search_Text")
                .HtmlAttributes(new { placeholder = "Tài khoản/ Mã khách hàng/ Tên khách hàng", style = "background-color:white;width: 180px;color:green;!important;padding-left:3px;padding-right: 2px;!important;" })
                .Value("")
                )

            &nbsp;&nbsp;  &nbsp;&nbsp;
            @(Html.Kendo().Button()
                .Name("btnSearchTideRateConfigure")
                .Events(ev => ev.Click("onSearchLoanDetail"))
                .HtmlAttributes(new { type = "button", style = "font-weight:bold; width:100px; color: blue;padding-left: 0px; height: 25px;", title = "Tìm kiếm danh sách quyết định cấu hình lãi suất rút trước hạn TG CKH" })
                .ImageUrl(Url.Content("~/images/tim_kiem.png"))
                .Content(" Tìm kiếm "))
        </div>
    </div>

    <div class="col-md-12">
        @(
            Html.Kendo().Grid<VBSPOSS.ViewModels.ChangePosDataCheckingViewModel>()
                .Name("gridMainTranferTarget")
                .Columns(columns =>
                {
                    if (ViewBag.PSourceTarget?.ToString() == "T")
                    {
                        columns.Bound(c => c.ACCEPT_MOV)
                        .Title("Xác nhận")
                        .Width(80)
                        .ClientTemplate(
                        "<input type='checkbox' class='chkAcceptMov' #= ACCEPT_MOV ? 'checked=checked' : '' # />")
                        .HtmlAttributes(new { style = "text-align:center;" });
                    }
                else
                {
                    columns.Bound(c => c.ACCEPT_MOV)
                    .Title("Xác nhận")
                    .Width(80)
                    .ClientTemplate(
                    "<input type='checkbox' class='chkAcceptMov' #= ACCEPT_MOV ? 'checked=checked' : '' # readonly='readonly' disabled='disabled' />")
                    .HtmlAttributes(new { style = "text-align:center;" });
                }

                columns.Bound(c => c.TYPE_CD).Title("Loại dữ liệu").Width(120);
                columns.Bound(c => c.CUST_ID).Title("Mã KH").Width(120);
                columns.Bound(c => c.CUST_NAME).Title("Tên khách hàng").Width(250);
                columns.Bound(c => c.AC_NO).Title("Số tài khoản").Width(150);
                columns.Bound(c => c.PROD_CD).Title("Sản phẩm").Width(120);
                columns.Bound(c => c.PRIN_AMOUNT)
                .Title("Dư nợ")
                .Width(120)
                .Format("{0:n0}")
                .HtmlAttributes(new { style = "text-align:right;" });
                columns.Bound(c => c.POS_CD).Title("POS cũ").Width(100);
                columns.Bound(c => c.NEW_POS_CD).Title("POS mới").Width(100);
                columns.Bound(c => c.SCOM_CD).Title("Thôn cũ").Width(120);
                columns.Bound(c => c.NEW_SCOM_CD).Title("Thôn mới").Width(120);
            })
            .ToolBar(toolbar => { toolbar.Excel().Text("Xuất Excel"); })
            .Excel(excel => excel
            .FileName("Danh_sach_dieu_chuyen_du_lieu.xlsx")
            .AllPages(true))
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
            .Sortable()
            .Scrollable()
            @* .Filterable() *@
            .Resizable(resize => resize.Columns(true))
            .HtmlAttributes(new { style = "height:515px;" })
            .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(15)
            .ServerOperation(false)
            .Model(model => { model.Id(p => p.CUST_ID); })
            .Read(read => read
            .Action("LoadGridData_TransPointTarget1", "TransferDataPos")
            .Data("paramLoadGridData")))
            )
    </div>
</div>


@if (ViewBag.PSourceTarget?.ToString() == "T")
{
    <label class="control-label" id="lblMessageInfor" style="width: 1260px; text-align: left; color: red;"></label>
    <div class="row" style="padding-top:10px;">
        <div class="col-md-12">

            @(Html.Kendo().Button()
                .Name("btnSaveAcceptMove")
                .HtmlAttributes(new
                {
                    type = "button",
                    style = "width: 150px; font-weight:bold; color: blue; height: 30px;",
                    title = "Lưu xác nhận chuyển thôn",
                    onclick = "saveAcceptMove();"
                })
                .ImageUrl(Url.Content("~/images/save.png"))
                .Content(" Lưu xác nhận"))

        </div>
    </div>
}
<script>
    function saveAcceptMove() {
        var grid = $("#gridMainTranferTarget").data("kendoGrid");
        var data = [];

        $("#gridMainTranferTarget tbody tr").each(function () {
            var item = grid.dataItem(this);
            var checked = $(this).find(".chkAcceptMov").is(":checked");

            data.push({
                CUST_ID: item.CUST_ID,
                AC_NO: item.AC_NO,
                PROD_CD: item.PROD_CD,
                ACCEPT_MOV: checked
            });
        });

        $.ajax({
            url: '/TransferDataPos/SaveAcceptMove',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (res === 1) {
                    alert("Lưu dữ liệu thành công!");
                } else {
                    alert("Lưu dữ liệu thất bại!");
                }
            },
            error: function () {
                alert("Có lỗi khi lưu dữ liệu!");
            }
        });
    }
</script>
